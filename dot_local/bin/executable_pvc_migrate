#!/bin/bash
# Copy pvc data into a new one, delete pod after logs says DONE
# usage: ./migrate.sh <app> <old-claim> <new-claim> <namespace>
APP=$1
OLD=$2
NEW=$3
NS=$4

cat <<EOF | kubectl apply -f -
apiVersion: v1
kind: Pod
metadata:
  name: ${APP}-migrate
  namespace: ${NS}
spec:
  restartPolicy: Never
  containers:
    - name: copy
      image: alpine:3.20
      command: ["sh", "-c", "du -sh /old && apk add --no-cache rsync >/dev/null && rsync -avh --info=progress2 /old/ /new/ && echo DONE && sleep 3600"]
      volumeMounts:
        - {name: old, mountPath: /old}
        - {name: new, mountPath: /new}
  volumes:
    - name: old
      persistentVolumeClaim: {claimName: ${OLD}}
    - name: new
      persistentVolumeClaim: {claimName: ${NEW}}
EOF
