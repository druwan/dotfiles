#!/usr/bin/env bash
set -euo pipefail

LOG="$HOME/.local/state/immich-library-mirror.log"
CACHE="$HOME/.local/state/immich-pvc-name.cache"
mkdir -p "$(dirname "$LOG")"
exec >>"$LOG" 2>&1
echo "=== $(date -Iseconds) starting mirror ==="

NAS_HOST="192.168.1.83"
MOUNT_POINT="/mnt/nas-pvc"
LOCAL_MIRROR="$HOME/immich-photos"

mkdir -p "$LOCAL_MIRROR"

for i in $(seq 1 30); do
  ping -c1 -W1 "$NAS_HOST" &>/dev/null && break
  sleep 2
done

if ! ping -c1 -W1 "$NAS_HOST" &>/dev/null; then
  echo "NAS unreachable after retries, aborting."
  exit 1
fi

# Resolve the current PV name dynamically, falling back to cache if the
# cluster isn't reachable from this network right now.
if PVC_ID=$(kubectl get pvc immich-library -n immich -o jsonpath='{.spec.volumeName}' 2>/dev/null) && [[ -n "$PVC_ID" ]]; then
  echo "$PVC_ID" >"$CACHE"
  echo "Resolved PV live: $PVC_ID"
elif [[ -f "$CACHE" ]]; then
  PVC_ID=$(cat "$CACHE")
  echo "Cluster unreachable, using cached PV: $PVC_ID"
else
  echo "Cluster unreachable and no cache available, aborting."
  exit 1
fi

if ! stat "$MOUNT_POINT/$PVC_ID/library" &>/dev/null; then
  echo "NAS share did not automount or path $PVC_ID/library missing, aborting."
  exit 1
fi

rsync -a --delete "$MOUNT_POINT/$PVC_ID/library/" "$LOCAL_MIRROR/"

echo "=== $(date -Iseconds) done ==="
