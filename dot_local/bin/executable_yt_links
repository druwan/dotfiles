#!/usr/bin/env bash

usage() {
  cat <<EOF
Usage: yt-links.sh [OPTIONS] <url> [url2 url3 ...]

Download YouTube videos using yt-dlp.
Note: URLs must be quoted due to special chars..

OPTIONS:
  -h, --help          Show this help message
  -o, --output DIR    Output directory (default: /tmp)

EXAMPLES:
  yt-links.sh "https://www.youtube.com/watch?v=NrR_RdRRE2w"
  yt-links.sh "https://youtu.be/abc123" "https://youtu.be/def456"
  yt-links.sh -o ~/Videos "https://youtu.be/abc123"
EOF
}

OUTPUT_DIR="/tmp"

while [[ $# -gt 0 ]]; do
  case "$1" in
  -h | --help)
    usage
    exit 0
    ;;
  -o | --output)
    OUTPUT_DIR="$2"
    shift 2
    ;;
  *) break ;;
  esac
done

if [ $# -lt 1 ]; then
  echo "ERROR: Missing yt link(s)"
  usage
  exit 1
fi

for link in "$@"; do
  echo -en "Downloading $link"
  yt-dlp \
    --format "bv*[ext=mp4]+ba[ext=m4a]/[ext=mp4]" \
    --restrict-filenames \
    -o "${OUTPUT_DIR}/%(title)s.%(ext)s" \
    "$link"
done
