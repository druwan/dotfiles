#!/bin/zsh
set -euo pipefail

SCRIPT_NAME="${0:t}"

usage() {
  cat << EOF
Usage: $SCRIPT_NAME <note title words...>

Create a new markdown note in $NOTES and opens it in nvim.
The title gets slugified.

Options:
  -h, --help   Show this help message and exit

Example:
  $SCRIPT_NAME "Meeting notes for Q3 planning"
  -> creates $NOTES/meeting-notes-for-q3-planning.md
EOF
}

if [ $# -ge 1 ] && { [ "$1" = "-h" ] || [ "$1" = "--help" ]; } ;then
  usage
  exit 0
fi

if [ $# -lt 1 ]; then
  echo -en "Error: missing new note name"
  exit 1
fi

# Combine all args into a single string
input="$*"

# Let python handle lowercase-dash-separated-slug, filename & alias
read -r slug title <<< $(python3 -c "
import re, sys

def deswedify(s: str) -> str:
  return s.replace('Å','a').replace('Ä','a').replace('Ö','o').replace('å','a').replace('ä','a').replace('ö','o')

def slugify(s: str) -> str:
    s = deswedify(s).lower()
    s = re.sub(r'[^a-z0-9]+', '-', s)
    return s.strip('-')


inp = '$input'
slug = slugify(inp)
title = inp.capitalize()
print(slug, title)
")

filename="${slug}.md"
note_path="$NOTES/$filename"

touch "$note_path"
nvim "$note_path"
